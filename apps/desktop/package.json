{
  "name": "focusflow-desktop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-ffmpeg.ps1",
    "prepare:nsis": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-tauri-nsis.ps1",
    "bundle": "npm run prepare:ffmpeg && npm run prepare:nsis && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
