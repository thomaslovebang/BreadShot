{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusFlow",
  "version": "0.1.0",
  "identifier": "app.focusflow.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "FocusFlow", "width": 1120, "height": 720, "minWidth": 720, "minHeight": 480 }],
    "security": { "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis"] }
}
