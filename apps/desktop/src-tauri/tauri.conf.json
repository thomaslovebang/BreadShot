{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusFlow",
  "mainBinaryName": "FocusFlow",
  "version": "0.2.0",
  "identifier": "app.focusflow.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1470", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "FocusFlow", "width": 1200, "height": 820, "minWidth": 880, "minHeight": 640 }],
    "security": { "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "publisher": "FocusFlow",
    "homepage": "https://github.com/thomaslovebang/FocusFlow9",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "bin/ffprobe.exe": "bin/ffprobe.exe",
      "legal/FFmpeg-GPL-3.0.txt": "legal/FFmpeg-GPL-3.0.txt",
      "legal/FFmpeg-build-README.txt": "legal/FFmpeg-build-README.txt",
      "legal/FFmpeg-package.sha256": "legal/FFmpeg-package.sha256",
      "../../../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md"
    },
    "copyright": "Copyright © 2026 FocusFlow contributors",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "category": "Video",
    "shortDescription": "Free Windows screen recorder with automatic zoom and pan.",
    "longDescription": "FocusFlow records one Windows display and automatically turns mouse actions into smooth zoom and pan camera motion. Processing stays on the device and exports a watermark-free MP4.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}

